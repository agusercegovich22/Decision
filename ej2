/*Ingresar un número entero e indicar si es par o impar*/

#include <stdio.h>
#include <stdlib.h>

int main(){
    int n;
    printf("Ingresar un numero entero: ");
    scanf("%d", &n);
    if(n%2 == 0)
        printf("%d es un numero par", n);
    else
        printf("%d es un numero impar", n);
    printf("\n");
    system("pause");
    return 0;
}
