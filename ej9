/*9. Al efectuar una compra, si adquirimos más de 100 unidades de un mismo artículo, nos hacen un descuento
de un 40%; entre 25 y 100 unidades un 20%; entre 10 y 24 unidades un 10% y no hay descuento para menos
de 10 unidades. Hacer un programa que calcule el importe a pagar ingresando la cantidad de unidades
vendidas y el valor unitario.
*/

#include <stdio.h>
#include <stdlib.h>

int main(){
    int unidad;
    float valor;
    printf("Ingresar la cantidad de unidades: ");
    scanf("%d", &unidad);
    printf("Ingresar el valor del articulo: ");
    scanf("%f", &valor);
    if(unidad>100)
        printf("Con un descuento del 40 porciento el total a pagar es: $%f", unidad*valor*0.6);
    else
        if(unidad>=25 && unidad<=100)
            printf("Con un descuento del 20 porciento el total a pagar es: $%f", unidad*valor*0.8);
        else
            if(unidad>=10 && unidad<=24)
                printf("Con un descuento del 10 porciento el total a pagar es: $%f", unidad*valor*0.9);
            else
                printf("Sin descuento el total a pagar es: $%f", unidad*valor*0.9);
    printf("\n");
    system("pause");
    return 0;
}
